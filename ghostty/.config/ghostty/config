font-family = "JetBrainsMono Nerd Font Mono"
font-size = 11
theme = TokyoNight

cursor-style = bar
cursor-style-blink = false

window-padding-x = 10
window-padding-y = 10

scrollback-limit = 10000
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
shell-integration = detect

# macOS: left Option sends Alt (for tmux M-h / M-l); right Option still types
# special characters. Ignored on Linux.
macos-option-as-alt = left

# undercurl support (neovim diagnostics/spell)
term = xterm-ghostty
