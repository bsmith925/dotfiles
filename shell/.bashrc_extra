# sourced from ~/.bashrc — add: [ -f ~/.bashrc_extra ] && source ~/.bashrc_extra

[ -f ~/.aliases ] && source ~/.aliases

export EDITOR=nvim
export VISUAL=nvim

# Homebrew (macOS): Apple Silicon installs to /opt/homebrew, Intel to /usr/local
case "$OSTYPE" in
  darwin*)
    if ! command -v brew >/dev/null 2>&1; then
      for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$_brew" ]; then eval "$("$_brew" shellenv)"; break; fi
      done
      unset _brew
    fi
    ;;
esac

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"       # Rust (rustup)
export PATH="$HOME/.local/go/bin:$PATH"    # Go toolchain
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"            # go install binaries
